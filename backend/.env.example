# Copy to backend/.env (never commit). All variables use the MDA_ prefix.
MDA_DATABASE_URL=postgresql+psycopg://mda:choose-a-local-password@localhost:5432/mda
MDA_TEST_DATABASE_URL=postgresql+psycopg://mda:choose-a-local-password@localhost:5432/mda_test
# Must be true whenever the app is served over HTTPS (any shared environment).
MDA_COOKIE_SECURE=false
MDA_TIMEZONE=Asia/Jerusalem
MDA_SESSION_IDLE_DAYS=30
MDA_DRAFT_IDLE_MINUTES=10
# "none" = no phone provider connected; notifications are shown in-app and marked simulated.
MDA_PUSH_CHANNEL=none
